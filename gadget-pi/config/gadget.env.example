# Gadget-Pi parameter block.
#
# Copy this file to `gadget.env` (which is git-ignored) and edit the values.
# Every script in scripts/host and scripts/pi sources ../config/gadget.env
# automatically if it exists.
#
# Each line uses the `${VAR:-default}` form so a value already present in the
# environment WINS over the file. That means you can override any single value
# for one run without editing this file:
#
#   BOOTFS=/Volumes/bootfs ./scripts/host/write-user-data.sh
#
# Do NOT commit the real gadget.env — it can contain a plaintext password.

# ---- Identity -------------------------------------------------------------
export PI_HOSTNAME="${PI_HOSTNAME:-stephen-pi}"
export PI_USER="${PI_USER:-stephen}"
# Leave PI_PASSWORD empty if you use SSH keys only (recommended).
export PI_PASSWORD="${PI_PASSWORD:-CHANGE-ME-NOW}"
export PI_TIMEZONE="${PI_TIMEZONE:-America/Chicago}"

# Optional: path to an SSH public key. When set, write-user-data.sh --ssh-key
# and the cloud-init key template use it instead of a plaintext password.
export PI_SSH_PUBKEY_FILE="${PI_SSH_PUBKEY_FILE:-${HOME}/.ssh/id_ed25519.pub}"

# ---- Host-side paths ------------------------------------------------------
export RPI_WORKDIR="${RPI_WORKDIR:-${HOME}/rpi-gadget-setup}"

# When editing a freshly flashed boot partition, point this at the mounted
# FAT32 boot volume.
#   macOS:  /Volumes/bootfs
#   Linux:  /media/${USER}/bootfs
export BOOTFS="${BOOTFS:-/path/to/bootfs}"

# ---- Pi-side SSD-as-data options (only used by scripts/pi/setup-ssd-data.sh)
export SSD_DEV="${SSD_DEV:-/dev/sda}"
export SSD_PART="${SSD_PART:-/dev/sda1}"
export SSD_MOUNT="${SSD_MOUNT:-/srv/data}"
