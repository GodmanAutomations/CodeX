#!/usr/bin/env python3
"""Query Stephen's private Redcell Hugging Face llama.cpp endpoint."""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


DEFAULT_ENDPOINT = "https://aov66hh2kvl7pxt6.us-east-1.aws.endpoints.huggingface.cloud"
DEFAULT_ENDPOINT_NAME = "redcell-26b-a4b-osint-cyber--kce"
DEFAULT_NAMESPACE = "Memphis4065"
DEFAULT_MODEL = "/repository/REDCELL-26B-A4B-OSINT-Cyber-Q8_0.gguf"

DEFAULT_SYSTEM_PROMPT = """You are REDCELL, an OSINT-focused analytical model developed by terrorswift.
You support defensive cybersecurity, open-source intelligence, and investigative research.
Use professional analyst tradecraft: distinguish evidence from inference, calibrate confidence,
prefer passive reconnaissance, flag legal/ethical risk, and provide verification steps.
Do not dox, harass, threaten, or help misuse private information."""


def get_hf_token() -> str | None:
    for name in ("HF_TOKEN", "HUGGING_FACE_HUB_TOKEN", "HUGGINGFACEHUB_API_TOKEN", "HUGGINGFACE_TOKEN"):
        value = os.environ.get(name)
        if value:
            return value
    try:
        from huggingface_hub import get_token  # type: ignore
    except Exception:
        return None
    return get_token()


def read_prompt(args: argparse.Namespace) -> str:
    parts: list[str] = []
    if args.prompt_file:
        parts.append(Path(args.prompt_file).read_text(encoding="utf-8"))
    if args.prompt:
        parts.append(" ".join(args.prompt))
    if not sys.stdin.isatty():
        data = sys.stdin.read()
        if data.strip():
            parts.append(data)
    prompt = "\n\n".join(part.strip() for part in parts if part.strip())
    if not prompt:
        raise SystemExit("redcell-query: prompt required as arguments, stdin, or --prompt-file")
    return prompt


def read_system_prompt(args: argparse.Namespace) -> str:
    if args.no_system:
        return ""
    if args.system_file:
        return Path(args.system_file).read_text(encoding="utf-8").strip()
    return DEFAULT_SYSTEM_PROMPT


def post_json(url: str, token: str, payload: dict[str, Any], timeout: int) -> dict[str, Any]:
    request = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")[:1200]
        raise SystemExit(f"redcell-query: endpoint HTTP {exc.code}: {body}") from exc
    except urllib.error.URLError as exc:
        raise SystemExit(f"redcell-query: endpoint request failed: {exc}") from exc


def get_json(url: str, token: str, timeout: int) -> dict[str, Any]:
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}"})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")[:1200]
        raise SystemExit(f"redcell-query: endpoint HTTP {exc.code}: {body}") from exc
    except urllib.error.URLError as exc:
        raise SystemExit(f"redcell-query: endpoint request failed: {exc}") from exc


def run_hf_endpoint_command(action: str, args: argparse.Namespace) -> int:
    command = [
        "hf",
        "endpoints",
        action,
        args.endpoint_name,
        "--namespace",
        args.namespace,
    ]
    result = subprocess.run(command, check=False, text=True, capture_output=True)
    if result.stdout.strip():
        print(result.stdout.strip())
    if result.stderr.strip():
        print(result.stderr.strip(), file=sys.stderr)
    return result.returncode


def status(args: argparse.Namespace) -> int:
    token = get_hf_token()
    if not token:
        raise SystemExit("redcell-query: no Hugging Face token found")
    props = get_json(args.endpoint.rstrip("/") + "/props", token, args.timeout)
    params = props.get("default_generation_settings", {}).get("params", {})
    payload = {
        "ok": True,
        "endpoint": args.endpoint,
        "model_alias": props.get("model_alias"),
        "model_ftype": props.get("model_ftype"),
        "n_ctx": props.get("default_generation_settings", {}).get("n_ctx"),
        "modalities": props.get("modalities"),
        "chat_format": params.get("chat_format"),
        "reasoning_format": params.get("reasoning_format"),
        "reasoning_in_content_default": params.get("reasoning_in_content"),
        "temperature_default": params.get("temperature"),
        "top_k_default": params.get("top_k"),
        "top_p_default": params.get("top_p"),
        "min_p_default": params.get("min_p"),
        "repeat_penalty_default": params.get("repeat_penalty"),
    }
    print(json.dumps(payload, indent=2, sort_keys=True))
    return 0


def query_chat(args: argparse.Namespace) -> dict[str, Any]:
    token = get_hf_token()
    if not token:
        raise SystemExit("redcell-query: no Hugging Face token found")
    prompt = read_prompt(args)
    system_prompt = read_system_prompt(args)
    messages = []
    if system_prompt:
        messages.append({"role": "system", "content": system_prompt})
    messages.append({"role": "user", "content": prompt})
    payload = {
        "model": args.model,
        "messages": messages,
        "temperature": args.temperature,
        "top_k": args.top_k,
        "top_p": args.top_p,
        "min_p": args.min_p,
        "repeat_penalty": args.repeat_penalty,
        "max_tokens": args.max_tokens,
        "reasoning_in_content": True,
        "stream": False,
    }
    started = time.monotonic()
    data = post_json(args.endpoint.rstrip("/") + "/v1/chat/completions", token, payload, args.timeout)
    elapsed_ms = int((time.monotonic() - started) * 1000)
    choice = (data.get("choices") or [{}])[0]
    message = choice.get("message") or {}
    content = message.get("content") or ""
    result = {
        "ok": bool(content.strip()),
        "endpoint": args.endpoint,
        "model": data.get("model") or args.model,
        "finish_reason": choice.get("finish_reason"),
        "elapsed_ms": elapsed_ms,
        "usage": data.get("usage"),
        "content": content,
    }
    if not result["ok"] and result["finish_reason"] == "length":
        result["error"] = "empty content before token limit; increase --max-tokens"
    return result


def query_completion(args: argparse.Namespace) -> dict[str, Any]:
    token = get_hf_token()
    if not token:
        raise SystemExit("redcell-query: no Hugging Face token found")
    prompt = read_prompt(args)
    payload = {
        "prompt": prompt,
        "temperature": args.temperature,
        "top_k": args.top_k,
        "top_p": args.top_p,
        "min_p": args.min_p,
        "repeat_penalty": args.repeat_penalty,
        "n_predict": args.max_tokens,
        "stream": False,
    }
    if args.stop:
        payload["stop"] = args.stop
    started = time.monotonic()
    data = post_json(args.endpoint.rstrip("/") + "/completion", token, payload, args.timeout)
    elapsed_ms = int((time.monotonic() - started) * 1000)
    content = data.get("content") or ""
    result = {
        "ok": bool(content.strip()),
        "endpoint": args.endpoint,
        "model": data.get("model") or args.model,
        "finish_reason": data.get("stop_type"),
        "elapsed_ms": elapsed_ms,
        "usage": {
            "prompt_tokens": data.get("tokens_evaluated"),
            "completion_tokens": data.get("tokens_predicted"),
        },
        "content": content,
    }
    if not result["ok"] and result["finish_reason"] == "limit":
        result["error"] = "empty content before token limit; increase --max-tokens"
    return result


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Query Stephen's private Redcell OSINT/cyber Hugging Face endpoint."
    )
    parser.add_argument("prompt", nargs="*", help="Prompt text. Stdin is also accepted.")
    parser.add_argument("--prompt-file", help="Read prompt text from a file.")
    parser.add_argument("--system-file", help="Override the default Redcell system prompt.")
    parser.add_argument("--no-system", action="store_true", help="Do not send the default system prompt.")
    parser.add_argument("--endpoint", default=DEFAULT_ENDPOINT)
    parser.add_argument("--endpoint-name", default=DEFAULT_ENDPOINT_NAME)
    parser.add_argument("--namespace", default=DEFAULT_NAMESPACE)
    parser.add_argument("--model", default=DEFAULT_MODEL)
    parser.add_argument("--max-tokens", type=int, default=1200)
    parser.add_argument("--temperature", type=float, default=0.5)
    parser.add_argument("--top-k", type=int, default=64)
    parser.add_argument("--top-p", type=float, default=0.95)
    parser.add_argument("--min-p", type=float, default=0.0)
    parser.add_argument("--repeat-penalty", type=float, default=1.0)
    parser.add_argument("--timeout", type=int, default=180)
    parser.add_argument("--completion", action="store_true", help="Use llama.cpp /completion instead of chat.")
    parser.add_argument("--stop", action="append", help="Stop sequence for --completion. May be repeated.")
    parser.add_argument("--json", action="store_true", help="Print structured JSON wrapper.")
    parser.add_argument("--status", action="store_true", help="Print read-only live endpoint props.")
    parser.add_argument("--resume", action="store_true", help="Resume the Hugging Face endpoint.")
    parser.add_argument("--scale-zero", action="store_true", help="Scale the endpoint to zero to stop billing.")
    return parser


def main() -> int:
    args = build_parser().parse_args()
    action_count = sum(bool(value) for value in (args.status, args.resume, args.scale_zero))
    if action_count > 1:
        raise SystemExit("redcell-query: choose only one of --status, --resume, or --scale-zero")
    if args.resume:
        return run_hf_endpoint_command("resume", args)
    if args.scale_zero:
        return run_hf_endpoint_command("scale-to-zero", args)
    if args.status:
        return status(args)

    result = query_completion(args) if args.completion else query_chat(args)
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    else:
        print(result["content"].strip())
    return 0 if result["ok"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
